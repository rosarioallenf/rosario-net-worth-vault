# Copy this into .streamlit/secrets.toml for local runs, and paste the same
# three lines into the app's "Secrets" box when you deploy on Streamlit
# Community Cloud. Never commit an actual secrets.toml file to GitHub -
# .gitignore below already excludes it, but double-check before pushing.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
# Project Settings -> API -> service_role key (NOT the anon/public key -
# service_role is what lets this app read everything despite RLS being on)
SUPABASE_SERVICE_KEY = "your-service-role-key"
# Whatever passphrase you want to gate the app with. Share it with Maria/kids
# the same way you'd share any other emergency-access credential.
APP_PASSPHRASE = "choose-a-passphrase"
